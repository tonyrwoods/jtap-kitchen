{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "tax_rate": {
      "type": "number",
      "title": "Sales Tax Rate (%)",
      "default": 9.25,
      "description": "Memphis/Shelby County rate \u2014 update if location or rate changes"
    },
    "mileage_rate": {
      "type": "number",
      "title": "IRS Mileage Reimbursement Rate ($ per mile)",
      "default": 0.7,
      "description": "2025/2026 IRS standard mileage rate"
    },
    "max_capacity": {
      "type": "number",
      "title": "Restaurant Max Seating Capacity",
      "default": 80
    },
    "brunch_capacity": {
      "type": "number",
      "title": "Brunch Max Seating Capacity",
      "default": 80
    },
    "lunch_capacity": {
      "type": "number",
      "title": "Lunch Max Seating Capacity",
      "default": 80
    },
    "dinner_capacity": {
      "type": "number",
      "title": "Dinner Max Seating Capacity",
      "default": 80
    },
    "max_reservation_party_size": {
      "type": "number",
      "title": "Max Party Size for Online Reservations",
      "default": 10
    },
    "slot_interval_minutes": {
      "type": "number",
      "title": "Reservation Time Slot Interval (minutes)",
      "default": 30
    },
    "dining_duration_minutes": {
      "type": "number",
      "title": "Default Dining Duration (minutes per turn)",
      "default": 90
    },
    "restaurant_name": {
      "type": "string",
      "title": "Restaurant Name",
      "default": "JTAP Kitchen"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email"
    },
    "contact_phone": {
      "type": "string",
      "title": "Contact Phone"
    },
    "address": {
      "type": "string",
      "title": "Restaurant Address"
    },
    "loyalty_points_per_dollar": {
      "type": "number",
      "title": "Loyalty Points Earned Per Dollar Spent",
      "default": 1
    },
    "loyalty_points_redemption_value": {
      "type": "number",
      "title": "Dollar Value Per 100 Points",
      "default": 5
    },
    "gift_card_expiry_months": {
      "type": "number",
      "title": "Gift Card Expiry (months from purchase)",
      "default": 12
    },
    "social_default_platforms": {
      "type": "array",
      "title": "Auto-Post Platforms",
      "items": {
        "type": "string",
        "enum": [
          "instagram",
          "facebook",
          "linkedin"
        ]
      },
      "default": [
        "instagram",
        "facebook",
        "linkedin"
      ]
    },
    "social_caption_template": {
      "type": "string",
      "title": "Social Post Caption Template"
    },
    "social_hashtags": {
      "type": "string",
      "title": "Social Hashtags (comma-separated)",
      "default": "jtapkitchen, memphis, foodie"
    },
    "referral_bonus_last_run_at": {
      "type": "string",
      "title": "Referral Bonus Job Last Run (ISO)"
    },
    "reservation_deposit_enabled": {
      "type": "boolean",
      "title": "Require Reservation Deposit",
      "default": false
    },
    "reservation_deposit_amount": {
      "type": "number",
      "title": "Deposit Amount per Guest (USD)",
      "default": 10
    },
    "reservation_deposit_min_party_size": {
      "type": "number",
      "title": "Min Party Size Requiring Deposit",
      "default": 6,
      "description": "Parties of this size or larger require a deposit. Set to 1 to require all reservations."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}