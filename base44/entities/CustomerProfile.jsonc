{
  "name": "CustomerProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Customer Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "total_visits": {
      "type": "number",
      "title": "Total Visits",
      "default": 0
    },
    "total_spend": {
      "type": "number",
      "title": "Total Spend ($)",
      "default": 0
    },
    "loyalty_points": {
      "type": "number",
      "title": "Loyalty Points",
      "default": 0
    },
    "loyalty_tier": {
      "type": "string",
      "title": "Loyalty Tier",
      "enum": [
        "Bronze",
        "Silver",
        "Gold",
        "Platinum"
      ],
      "default": "Bronze"
    },
    "dietary_restrictions": {
      "type": "array",
      "title": "Dietary Restrictions",
      "items": {
        "type": "string",
        "enum": [
          "Vegetarian",
          "Vegan",
          "Gluten-Free",
          "Dairy-Free",
          "Nut Allergy",
          "Shellfish Allergy",
          "Egg Allergy",
          "Soy Allergy",
          "Pescatarian",
          "Halal",
          "Kosher",
          "Low-Sodium",
          "Diabetic",
          "Pregnancy"
        ]
      }
    },
    "favorite_dishes": {
      "type": "string",
      "title": "Favorite Dishes"
    },
    "order_history": {
      "type": "array",
      "title": "Order History",
      "items": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string"
          },
          "receipt_number": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "items_count": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}