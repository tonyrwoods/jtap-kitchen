{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Event Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "Wine Tasting",
        "Tasting Menu",
        "Holiday Dinner",
        "Chef's Table",
        "Cooking Class",
        "Special Occasion",
        "Other"
      ]
    },
    "date": {
      "type": "string",
      "title": "Date (YYYY-MM-DD)"
    },
    "time": {
      "type": "string",
      "title": "Time (HH:MM)"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (minutes)",
      "default": 120
    },
    "image_url": {
      "type": "string",
      "title": "Event Image URL"
    },
    "price_per_guest": {
      "type": "number",
      "title": "Price per Guest (USD)"
    },
    "max_capacity": {
      "type": "number",
      "title": "Max Capacity"
    },
    "spots_available": {
      "type": "number",
      "title": "Spots Available"
    },
    "menu_details": {
      "type": "string",
      "title": "Menu Details / Itinerary"
    },
    "featured": {
      "type": "boolean",
      "title": "Featured Event",
      "default": false
    },
    "is_published": {
      "type": "boolean",
      "title": "Publish on Website",
      "default": true
    }
  },
  "required": [
    "title",
    "event_type",
    "date",
    "time",
    "price_per_guest",
    "max_capacity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}