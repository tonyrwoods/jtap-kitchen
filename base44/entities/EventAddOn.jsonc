{
  "name": "EventAddOn",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "price": {
      "type": "number",
      "title": "Price (USD)"
    },
    "price_unit": {
      "type": "string",
      "title": "Price Unit",
      "enum": [
        "Flat Fee",
        "Per Hour"
      ],
      "default": "Flat Fee"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Audio/Visual",
        "Decor",
        "Photography",
        "Other"
      ]
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "inventory_limit": {
      "type": "number",
      "title": "Inventory Limit (max per date; blank = unlimited)"
    }
  },
  "required": [
    "name",
    "price",
    "price_unit",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}