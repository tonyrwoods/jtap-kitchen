{
  "name": "EventCenterInquiry",
  "type": "object",
  "properties": {
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "Birthday Party",
        "Corporate Event",
        "Wedding Reception",
        "Baby/Bridal Shower",
        "Graduation Party",
        "Holiday Party",
        "Other"
      ]
    },
    "preferred_day": {
      "type": "string",
      "title": "Preferred Day",
      "enum": [
        "Sunday",
        "Monday",
        "Tuesday",
        "Flexible"
      ]
    },
    "preferred_date": {
      "type": "string",
      "title": "Preferred Date (YYYY-MM-DD)"
    },
    "guest_count": {
      "type": "number",
      "title": "Estimated Guest Count"
    },
    "package": {
      "type": "string",
      "title": "Package Interest",
      "enum": [
        "Social Gathering",
        "Elevated Experience",
        "Full Buyout",
        "Not Sure"
      ]
    },
    "package_name": {
      "type": "string",
      "title": "Package Name"
    },
    "event_date": {
      "type": "string",
      "title": "Event Date (YYYY-MM-DD)",
      "format": "date"
    },
    "selected_talent_ids": {
      "type": "array",
      "title": "Selected Talent",
      "items": {
        "type": "string",
        "relation": "EventServiceProvider",
        "format": "uuid"
      }
    },
    "selected_addon_ids": {
      "type": "array",
      "title": "Selected Add-Ons",
      "items": {
        "type": "string",
        "relation": "EventAddOn",
        "format": "uuid"
      }
    },
    "selected_menu_item_ids": {
      "type": "array",
      "title": "Selected Menu Items",
      "items": {
        "type": "string",
        "relation": "MenuItem",
        "format": "uuid"
      }
    },
    "estimated_total": {
      "type": "number",
      "title": "Estimated Total (USD)"
    },
    "deposit_amount": {
      "type": "number",
      "title": "Deposit Amount (USD)"
    },
    "deposit_status": {
      "type": "string",
      "title": "Deposit Status",
      "enum": [
        "Unpaid",
        "Paid",
        "Refunded"
      ],
      "default": "Unpaid"
    },
    "stripe_payment_id": {
      "type": "string",
      "title": "Stripe Payment ID (optional)"
    },
    "message": {
      "type": "string",
      "title": "Additional Details"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "Confirmed",
        "Talent Pending",
        "Declined"
      ],
      "default": "New"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "contact_name",
    "email",
    "preferred_day",
    "guest_count"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}