{
  "name": "EventServiceProvider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Wedding Planner",
        "Event Planner",
        "DJ",
        "Musician",
        "Photographer",
        "Florist",
        "MC / Host",
        "Clown / Entertainer",
        "Officiant",
        "Other"
      ]
    },
    "bio": {
      "type": "string",
      "title": "Bio"
    },
    "photo_url": {
      "type": "string",
      "title": "Photo URL",
      "format": "uri"
    },
    "base_rate": {
      "type": "number",
      "title": "Base Rate (USD)"
    },
    "rate_unit": {
      "type": "string",
      "title": "Rate Unit",
      "enum": [
        "Flat Rate",
        "Per Hour",
        "Per Guest"
      ],
      "default": "Flat Rate"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email (Internal \u2014 never shown to site visitors)",
      "format": "email"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}