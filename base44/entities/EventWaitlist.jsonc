{
  "name": "EventWaitlist",
  "type": "object",
  "properties": {
    "contact_name": {
      "type": "string",
      "title": "Contact Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "preferred_date": {
      "type": "string",
      "title": "Preferred Date (YYYY-MM-DD)"
    },
    "preferred_day": {
      "type": "string",
      "title": "Preferred Day",
      "enum": [
        "Sunday",
        "Monday",
        "Tuesday",
        "Flexible"
      ]
    },
    "guest_count": {
      "type": "number",
      "title": "Estimated Guest Count"
    },
    "event_type": {
      "type": "string",
      "title": "Event Type"
    },
    "package": {
      "type": "string",
      "title": "Package Interest",
      "enum": [
        "Social Gathering",
        "Elevated Experience",
        "Full Buyout",
        "Not Sure"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Waiting",
        "Notified",
        "Converted",
        "Expired"
      ],
      "default": "Waiting"
    },
    "notified_at": {
      "type": "string",
      "title": "Notified At (ISO)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "contact_name",
    "email",
    "preferred_day"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}