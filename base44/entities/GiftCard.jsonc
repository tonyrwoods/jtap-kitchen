{
  "name": "GiftCard",
  "properties": {
    "amount": {
      "title": "Amount (USD)",
      "type": "number"
    },
    "code": {
      "title": "Voucher Code",
      "type": "string"
    },
    "description": {
      "maxLength": 1000,
      "title": "Description",
      "type": "string"
    },
    "expiry_date": {
      "title": "Expiry Date (YYYY-MM-DD)",
      "type": "string"
    },
    "message": {
      "title": "Personal Message",
      "type": "string"
    },
    "purchaser_email": {
      "title": "Purchaser Email",
      "type": "string"
    },
    "purchaser_name": {
      "title": "Purchaser Name",
      "type": "string"
    },
    "redeemed_at": {
      "title": "Redeemed At",
      "type": "string"
    },
    "redeemed_by": {
      "title": "Redeemed By (Guest Name)",
      "type": "string"
    },
    "recipient_email": {
      "title": "Recipient Email",
      "type": "string"
    },
    "recipient_name": {
      "title": "Recipient Name",
      "type": "string"
    },
    "status": {
      "default": "Pending Payment",
      "enum": [
        "Pending Payment",
        "Active",
        "Redeemed",
        "Expired"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "amount",
    "purchaser_name",
    "purchaser_email"
  ],
  "type": "object"
}