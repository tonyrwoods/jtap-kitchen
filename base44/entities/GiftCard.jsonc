{
  "name": "GiftCard",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Voucher Code"
    },
    "amount": {
      "type": "number",
      "title": "Amount (USD)"
    },
    "purchaser_name": {
      "type": "string",
      "title": "Purchaser Name"
    },
    "purchaser_email": {
      "type": "string",
      "title": "Purchaser Email"
    },
    "recipient_name": {
      "type": "string",
      "title": "Recipient Name"
    },
    "recipient_email": {
      "type": "string",
      "title": "Recipient Email"
    },
    "message": {
      "type": "string",
      "title": "Personal Message"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Pending Payment",
        "Active",
        "Redeemed",
        "Expired"
      ],
      "default": "Pending Payment"
    },
    "redeemed_at": {
      "type": "string",
      "title": "Redeemed At"
    },
    "redeemed_by": {
      "type": "string",
      "title": "Redeemed By (Guest Name)"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "amount",
    "purchaser_name",
    "purchaser_email"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.purchaser_email": "{{user.email}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}