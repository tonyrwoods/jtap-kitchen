{
  "name": "InstagramPost",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "caption": {
      "type": "string",
      "title": "Caption"
    },
    "sort_order": {
      "type": "number",
      "title": "Display Order",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "title": "Show on Homepage",
      "default": true
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}