{
  "name": "InterviewSlot",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "title": "Date (YYYY-MM-DD)"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "title": "End Time (HH:MM)"
    },
    "location": {
      "type": "string",
      "title": "Location / Meeting Link",
      "default": "JTAP Kitchen \u2013 In Person"
    },
    "is_booked": {
      "type": "boolean",
      "title": "Booked",
      "default": false
    },
    "booked_by_application_id": {
      "type": "string",
      "title": "Booked By (Application ID)"
    },
    "booked_by_name": {
      "type": "string",
      "title": "Booked By (Applicant Name)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "date",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}