{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "receipt_number": {
      "type": "string",
      "title": "Receipt Number"
    },
    "order_id": {
      "type": "string",
      "title": "Linked Order ID"
    },
    "table_number": {
      "type": "number",
      "title": "Table Number"
    },
    "server_name": {
      "type": "string",
      "title": "Server Name"
    },
    "items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "menu_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal ($)",
      "default": 0
    },
    "discount_type": {
      "type": "string",
      "title": "Discount Type",
      "enum": [
        "None",
        "Percent",
        "Fixed"
      ],
      "default": "None"
    },
    "discount_value": {
      "type": "number",
      "title": "Discount Value",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount Amount ($)",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "title": "Tax Rate (%)",
      "default": 9.25
    },
    "tax_amount": {
      "type": "number",
      "title": "Tax Amount ($)",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total ($)",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Unpaid",
        "Paid",
        "Voided"
      ],
      "default": "Unpaid"
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method",
      "enum": [
        "Cash",
        "Card",
        "Other"
      ],
      "default": "Card"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "is_vendor_invoice": {
      "type": "boolean",
      "title": "Vendor Invoice",
      "default": false
    },
    "vendor_name": {
      "type": "string",
      "title": "Vendor Name"
    },
    "expense_category": {
      "type": "string",
      "title": "Expense Category",
      "enum": [
        "Food & Beverage",
        "Software Subscriptions",
        "Office Supplies",
        "Utilities",
        "Equipment & Maintenance",
        "Marketing & Advertising",
        "Professional Services",
        "Staffing & Labor",
        "Rent & Facilities",
        "Insurance",
        "Logistics & Shipping",
        "Sales Tax Paid",
        "Other"
      ]
    },
    "approval_status": {
      "type": "string",
      "title": "Approval Status",
      "enum": [
        "Pending Review",
        "Approved",
        "Rejected"
      ],
      "default": "Pending Review"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By (Admin Email)"
    },
    "approval_date": {
      "type": "string",
      "title": "Approval Date (YYYY-MM-DD)"
    },
    "rejection_reason": {
      "type": "string",
      "title": "Rejection Reason"
    },
    "installment_plan": {
      "type": "string",
      "title": "Installment Plan Type",
      "enum": [
        "None",
        "Specific Dates",
        "30 Days Apart"
      ],
      "default": "None"
    },
    "first_payment_due": {
      "type": "string",
      "title": "First Payment Due Date (YYYY-MM-DD)"
    },
    "documents": {
      "type": "array",
      "title": "Attached Documents",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Contract",
              "W-9",
              "Receipt",
              "Other"
            ]
          },
          "url": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string"
          }
        }
      }
    },
    "delivery_status": {
      "type": "string",
      "title": "Vendor Email Delivery Status",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "pending"
    },
    "delivered_at": {
      "type": "string",
      "title": "Delivery Timestamp (ISO 8601)"
    },
    "delivery_error": {
      "type": "string",
      "title": "Delivery Error Message"
    }
  },
  "required": [
    "table_number",
    "items",
    "total",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}