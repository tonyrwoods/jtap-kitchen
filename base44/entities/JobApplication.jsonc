{
  "name": "JobApplication",
  "properties": {
    "admin_notes": {
      "title": "Admin Notes",
      "type": "string"
    },
    "applicant_name": {
      "title": "Applicant Name",
      "type": "string"
    },
    "cover_letter": {
      "title": "Cover Letter / Message",
      "type": "string"
    },
    "email": {
      "title": "Email",
      "type": "string"
    },
    "experience_years": {
      "title": "Years of Experience",
      "type": "number"
    },
    "interview_date": {
      "title": "Interview Date (YYYY-MM-DD)",
      "type": "string"
    },
    "interview_invite_sent": {
      "default": false,
      "title": "Interview Invite Sent",
      "type": "boolean"
    },
    "interview_slot_id": {
      "title": "Booked Interview Slot ID",
      "type": "string"
    },
    "interview_time": {
      "title": "Interview Time (HH:MM)",
      "type": "string"
    },
    "job_listing_id": {
      "title": "Job Listing ID",
      "type": "string"
    },
    "job_title": {
      "title": "Job Title",
      "type": "string"
    },
    "phone": {
      "title": "Phone",
      "type": "string"
    },
    "resume_url": {
      "title": "Resume URL",
      "type": "string"
    },
    "status": {
      "default": "New",
      "enum": [
        "New",
        "Under Review",
        "Interview Scheduled",
        "Hired",
        "Rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "job_listing_id",
    "applicant_name",
    "email"
  ],
  "rls": {
    "create": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}