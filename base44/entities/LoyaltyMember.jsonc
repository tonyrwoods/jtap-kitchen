{
  "name": "LoyaltyMember",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string",
      "title": "Guest Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "total_visits": {
      "type": "number",
      "title": "Total Visits",
      "default": 0
    },
    "total_spending": {
      "type": "number",
      "title": "Total Spending ($)",
      "default": 0
    },
    "tier_id": {
      "type": "string",
      "title": "Current Tier ID"
    },
    "tier_name": {
      "type": "string",
      "title": "Current Tier Name"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "joined_date": {
      "type": "string",
      "title": "Member Since"
    }
  },
  "required": [
    "guest_name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}