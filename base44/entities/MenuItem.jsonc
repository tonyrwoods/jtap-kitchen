{
  "name": "MenuItem",
  "properties": {
    "category": {
      "enum": [
        "Brunch",
        "Brunch Sides",
        "Appetizers",
        "Salads & Sandwiches",
        "Entrees",
        "Lunch",
        "Lunch Sides",
        "Sides",
        "Desserts",
        "Drinks"
      ],
      "title": "Category",
      "type": "string"
    },
    "cost": {
      "title": "Food Cost (USD)",
      "type": "number"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "dietary_tags": {
      "items": {
        "enum": [
          "Vegetarian",
          "Vegan",
          "Gluten-Free",
          "Dairy-Free",
          "Contains Nuts",
          "Contains Dairy",
          "Contains Eggs",
          "Contains Soy",
          "Contains Wheat",
          "Contains Shellfish",
          "Contains Fish",
          "Contains Sesame",
          "Spicy",
          "Halal",
          "Kosher"
        ],
        "type": "string"
      },
      "title": "Dietary Tags",
      "type": "array"
    },
    "image_url": {
      "title": "Image URL",
      "type": "string"
    },
    "image_ai_generated": {
      "title": "Image AI-Generated",
      "type": "boolean",
      "default": false,
      "description": "True when the image was created by AI image generation rather than a real photo."
    },
    "is_featured": {
      "title": "Featured Dish",
      "type": "boolean"
    },
    "name": {
      "title": "Dish Name",
      "type": "string"
    },
    "price": {
      "title": "Price (USD)",
      "type": "number"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}