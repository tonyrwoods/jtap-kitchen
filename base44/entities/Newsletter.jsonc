{
  "name": "Newsletter",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "title": "Email Address"
    },
    "is_unsubscribed": {
      "type": "boolean",
      "title": "Unsubscribed",
      "default": false
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}