{
  "name": "Order",
  "properties": {
    "items": {
      "items": {
        "properties": {
          "menu_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "title": "Order Items",
      "type": "array"
    },
    "notes": {
      "title": "Special Notes",
      "type": "string"
    },
    "priority": {
      "default": "Normal",
      "enum": [
        "Normal",
        "Rush"
      ],
      "title": "Priority",
      "type": "string"
    },
    "customer_name": {
      "title": "Customer Name (self-order)",
      "type": "string",
      "description": "Set when a guest places their own order from the table QR menu or takeout."
    },
    "server_name": {
      "title": "Server Name",
      "type": "string"
    },
    "status": {
      "default": "New",
      "enum": [
        "Pending Payment",
        "New",
        "Preparing",
        "Ready",
        "Served"
      ],
      "title": "Status",
      "type": "string"
    },
    "table_number": {
      "title": "Table Number",
      "type": "number",
      "description": "Required for dine-in orders; null for takeout."
    },
    "order_type": {
      "title": "Order Type",
      "type": "string",
      "enum": [
        "dine_in",
        "takeout"
      ],
      "default": "dine_in"
    },
    "payment_status": {
      "title": "Payment Status",
      "type": "string",
      "enum": [
        "unpaid",
        "paid"
      ],
      "default": "unpaid"
    },
    "pickup_name": {
      "title": "Pickup Name (takeout)",
      "type": "string"
    },
    "pickup_phone": {
      "title": "Pickup Phone (takeout)",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}