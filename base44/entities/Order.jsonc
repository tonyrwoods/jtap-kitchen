{
  "name": "Order",
  "properties": {
    "items": {
      "items": {
        "properties": {
          "menu_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "title": "Order Items",
      "type": "array"
    },
    "notes": {
      "title": "Special Notes",
      "type": "string"
    },
    "priority": {
      "default": "Normal",
      "enum": [
        "Normal",
        "Rush"
      ],
      "title": "Priority",
      "type": "string"
    },
    "server_name": {
      "title": "Server Name",
      "type": "string"
    },
    "status": {
      "default": "New",
      "enum": [
        "New",
        "Preparing",
        "Ready",
        "Served"
      ],
      "title": "Status",
      "type": "string"
    },
    "table_number": {
      "title": "Table Number",
      "type": "number"
    }
  },
  "required": [
    "table_number",
    "status"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "staff"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}