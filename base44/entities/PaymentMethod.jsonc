{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string",
      "title": "Nickname (e.g. 'Main Checking')"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Bank Account",
        "Credit Card",
        "Debit Card"
      ],
      "default": "Bank Account"
    },
    "bank_name": {
      "type": "string",
      "title": "Bank / Issuer Name"
    },
    "account_last4": {
      "type": "string",
      "title": "Last 4 Digits"
    },
    "routing_number_last4": {
      "type": "string",
      "title": "Routing # Last 4 (Bank only)"
    },
    "account_holder": {
      "type": "string",
      "title": "Account Holder Name"
    },
    "is_default": {
      "type": "boolean",
      "title": "Default Payment Method",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "nickname",
    "type",
    "bank_name",
    "account_last4"
  ]
}