{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string",
      "title": "Guest Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "date": {
      "type": "string",
      "title": "Date"
    },
    "time": {
      "type": "string",
      "title": "Time"
    },
    "party_size": {
      "type": "number",
      "title": "Party Size"
    },
    "special_requests": {
      "type": "string",
      "title": "Special Requests"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Pending",
        "Confirmed",
        "Cancelled",
        "Completed"
      ],
      "default": "Pending"
    },
    "admin_notes": {
      "type": "string",
      "title": "Internal Admin Notes"
    },
    "confirm_token": {
      "type": "string",
      "title": "Confirm Token (RSVP link)"
    },
    "confirmed_at": {
      "type": "string",
      "title": "Confirmed At (ISO)"
    },
    "declined_at": {
      "type": "string",
      "title": "Declined At (ISO)"
    },
    "reminder_sent_at": {
      "type": "string",
      "title": "Reminder Sent At (ISO)"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "guest_name",
    "email",
    "date",
    "time",
    "party_size"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}