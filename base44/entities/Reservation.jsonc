{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string",
      "title": "Guest Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "date": {
      "type": "string",
      "title": "Date"
    },
    "time": {
      "type": "string",
      "title": "Time"
    },
    "party_size": {
      "type": "number",
      "title": "Party Size"
    },
    "special_requests": {
      "type": "string",
      "title": "Special Requests"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Pending",
        "Pending Payment",
        "Confirmed",
        "Cancelled",
        "Completed",
        "No-Show"
      ],
      "default": "Pending"
    },
    "event_id": {
      "type": "string",
      "title": "Linked Event ID"
    },
    "admin_notes": {
      "type": "string",
      "title": "Internal Admin Notes"
    },
    "sms_opt_in": {
      "type": "boolean",
      "title": "Guest opted in to SMS",
      "default": false
    },
    "sms_sent_at": {
      "type": "string",
      "title": "SMS Confirmation Sent At (ISO)"
    },
    "confirm_token": {
      "type": "string",
      "title": "Confirm Token (RSVP link)"
    },
    "confirmed_at": {
      "type": "string",
      "title": "Confirmed At (ISO)"
    },
    "declined_at": {
      "type": "string",
      "title": "Declined At (ISO)"
    },
    "reminder_sent_at": {
      "type": "string",
      "title": "Reminder Sent At (ISO)"
    },
    "confirmation_email_sent_at": {
      "type": "string",
      "title": "Confirmation Email Sent At (ISO)"
    },
    "waitlist_notified_at": {
      "type": "string",
      "title": "Waitlist Notified At (ISO)"
    },
    "calendar_event_id": {
      "type": "string",
      "title": "Google Calendar Event ID"
    },
    "deposit_amount": {
      "type": "number",
      "title": "Deposit Amount (USD)"
    },
    "deposit_status": {
      "type": "string",
      "title": "Deposit Status",
      "enum": [
        "Unpaid",
        "Paid",
        "Refunded"
      ],
      "default": "Unpaid"
    },
    "stripe_payment_id": {
      "type": "string",
      "title": "Stripe Payment ID"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "guest_name",
    "email",
    "date",
    "time",
    "party_size"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}