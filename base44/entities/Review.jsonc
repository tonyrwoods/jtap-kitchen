{
  "name": "Review",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string",
      "title": "Guest Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1\u20135)"
    },
    "comment": {
      "type": "string",
      "title": "Review"
    },
    "visit_date": {
      "type": "string",
      "title": "Visit Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured on Homepage",
      "default": false
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "guest_name",
    "rating",
    "comment"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "Approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}