{
  "name": "Shift",
  "properties": {
    "date": {
      "title": "Date (YYYY-MM-DD)",
      "type": "string"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    },
    "role": {
      "title": "Role for Shift",
      "type": "string"
    },
    "shift_end_time": {
      "title": "End Time (HH:MM)",
      "type": "string"
    },
    "shift_start_time": {
      "title": "Start Time (HH:MM)",
      "type": "string"
    },
    "staff_color": {
      "title": "Staff Color",
      "type": "string"
    },
    "staff_id": {
      "title": "Staff Member ID",
      "type": "string"
    },
    "staff_name": {
      "title": "Staff Member Name",
      "type": "string"
    },
    "time_block": {
      "default": "Dinner (5pm\u20139pm)",
      "description": "Convenience label derived from start/end times",
      "enum": [
        "Breakfast (8am\u201311am)",
        "Lunch (11am\u20133pm)",
        "Dinner (5pm\u20139pm)",
        "Late Night (9pm\u201312am)",
        "Full Day",
        "Custom"
      ],
      "title": "Time Block",
      "type": "string"
    }
  },
  "required": [
    "staff_id",
    "date",
    "shift_start_time",
    "shift_end_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}