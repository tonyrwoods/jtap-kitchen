{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "enum": [
        "Manager",
        "Chef",
        "Sous Chef",
        "Server",
        "Host",
        "Bartender",
        "Busser",
        "Dishwasher"
      ],
      "default": "Server"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "color": {
      "type": "string",
      "title": "Display Color",
      "default": "#C89B4F"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "role"
  ]
}