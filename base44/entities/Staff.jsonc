{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "role": {
      "type": "string",
      "title": "Role",
      "enum": [
        "Manager",
        "Chef",
        "Sous Chef",
        "Server",
        "Host",
        "Bartender",
        "Busser",
        "Dishwasher"
      ],
      "default": "Server"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "shift": {
      "type": "string",
      "title": "Typical Shift"
    },
    "hourly_rate": {
      "type": "number",
      "title": "Hourly Rate (USD)"
    },
    "hire_date": {
      "type": "string",
      "title": "Hire Date (YYYY-MM-DD)"
    },
    "color": {
      "type": "string",
      "title": "Display Color",
      "default": "#C89B4F"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}