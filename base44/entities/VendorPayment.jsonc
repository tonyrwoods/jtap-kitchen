{
  "name": "VendorPayment",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "title": "Invoice ID"
    },
    "vendor_name": {
      "type": "string",
      "title": "Vendor Name"
    },
    "payment_number": {
      "type": "number",
      "title": "Payment #",
      "description": "1, 2, or 3"
    },
    "amount": {
      "type": "number",
      "title": "Payment Amount ($)"
    },
    "due_date": {
      "type": "string",
      "title": "Due Date (YYYY-MM-DD)"
    },
    "paid_date": {
      "type": "string",
      "title": "Paid Date (YYYY-MM-DD)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Pending",
        "Paid On Time",
        "Paid Late",
        "Overdue"
      ],
      "default": "Pending"
    },
    "payment_method_id": {
      "type": "string",
      "title": "Payment Method ID"
    },
    "payment_method_label": {
      "type": "string",
      "title": "Payment Method Label"
    },
    "is_reconciled": {
      "type": "boolean",
      "title": "Reconciled",
      "default": false
    },
    "reconciled_date": {
      "type": "string",
      "title": "Reconciled Date (YYYY-MM-DD)"
    },
    "has_discrepancy": {
      "type": "boolean",
      "title": "Has Discrepancy",
      "default": false
    },
    "discrepancy_amount": {
      "type": "number",
      "title": "Discrepancy Amount ($)"
    },
    "discrepancy_notes": {
      "type": "string",
      "title": "Discrepancy Notes"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "invoice_id",
    "vendor_name",
    "payment_number",
    "amount",
    "due_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}