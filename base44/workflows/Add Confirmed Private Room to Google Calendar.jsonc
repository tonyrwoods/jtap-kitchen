{
  "name": "Add Confirmed Private Room to Google Calendar",
  "description": "When a PrivateRoomRental becomes Confirmed and has no calendar event yet, create a Google Calendar event via addPrivateRoomToCalendar. Idempotent \u2014 skips once calendar_event_id is set.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Confirmed\") and (.trigger.data.calendar_event_id == null or .trigger.data.calendar_event_id == \"\" or .trigger.data.calendar_event_id == [] or .trigger.data.calendar_event_id == {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "PrivateRoomRental"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "add_confirmed_private_room_to_google_calendar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "addPrivateRoomToCalendar",
            "args": {
              "event": {
                "type": "${ .trigger.event_type }",
                "entity_name": "${ .trigger.entity_name }",
                "data": "${ .trigger.data }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync private room to calendar",
            "description": "Create Google Calendar event for confirmed private room booking"
          }
        }
      }
    ]
  }
}