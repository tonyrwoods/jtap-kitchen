{
  "name": "Add Confirmed Reservation to Google Calendar",
  "description": "When a Reservation becomes Confirmed (admin confirm or guest RSVP) and has no calendar event yet, create a Google Calendar event via addReservationToCalendar. Idempotent \u2014 skips once calendar_event_id is set.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Confirmed\") and (.trigger.data.calendar_event_id == null or .trigger.data.calendar_event_id == \"\" or .trigger.data.calendar_event_id == [] or .trigger.data.calendar_event_id == {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Reservation"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "add_confirmed_reservation_to_google_calendar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "addReservationToCalendar",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Create calendar event",
            "description": "Sync confirmed reservation to Google Calendar"
          }
        }
      }
    ]
  }
}