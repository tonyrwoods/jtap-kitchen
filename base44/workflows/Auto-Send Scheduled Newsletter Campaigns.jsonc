{
  "name": "Auto-Send Scheduled Newsletter Campaigns",
  "description": "Sends any NewsletterCampaign whose scheduled_at time has passed but is still in Scheduled status, so admins can pre-schedule campaigns and have them fire automatically.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-05T20:11:51.622000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_send_scheduled_newsletter_campaigns",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendScheduledCampaigns",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}