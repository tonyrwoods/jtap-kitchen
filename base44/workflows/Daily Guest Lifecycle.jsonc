{
  "description": "Daily job: syncs guest profiles from recent reservations, sends birthday offers to guests with upcoming birthdays, and sends win-back emails to lapsed guests (90+ days since last visit).",
  "name": "Daily Guest Lifecycle",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_guest_lifecycle",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_lifecycle": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyGuestLifecycle"
          },
          "then": "end",
          "x-base44": {
            "title": "Run guest lifecycle job",
            "description": "Sync profiles, send birthday & win-back emails"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}