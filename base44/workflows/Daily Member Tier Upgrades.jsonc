{
  "name": "Daily Member Tier Upgrades",
  "description": "Daily job that promotes active Tap Room Society members to a higher tier when their lifetime spend and visits cross an active LoyaltyTier's thresholds. Only promotes upward; never downgrades.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 9 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_member_tier_upgrades",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "upgradeMemberTiers",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Upgrade member tiers",
            "description": "Promote members past spend/visit thresholds"
          }
        }
      }
    ]
  }
}