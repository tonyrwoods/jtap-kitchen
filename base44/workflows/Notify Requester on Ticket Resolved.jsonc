{
  "name": "Notify Requester on Ticket Resolved",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Resolved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "SupportTicket"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_requester_on_ticket_resolved",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyTicketResolved",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}