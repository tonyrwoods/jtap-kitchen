{
  "name": "RSVP Confirmation Email",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"rsvp_responded_at\") != null) and (.trigger.data.rsvp_status == \"Attending\" or .trigger.data.rsvp_status == \"Declined\" or .trigger.data.rsvp_status == \"Maybe\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EventInvite"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rsvp_confirmation_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendRsvpConfirmation",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}