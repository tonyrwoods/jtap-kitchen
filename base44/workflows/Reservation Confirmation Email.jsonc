{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reservation_confirmation_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendReservationConfirmation",
            "args": {
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Reservation"
    }
  },
  "description": "Triggers sendReservationConfirmation when a new Reservation is created, sending the guest a confirmation link email and notifying admin staff.",
  "name": "Reservation Confirmation Email"
}