{
  "name": "Send Shift Notification - New Assignment",
  "description": "Automatically sends an email to staff when they are newly assigned to a shift",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Shift"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_shift_notification_new_assignment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendShiftNotification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}