{
  "name": "Send Shift Notification - Time Change",
  "description": "Automatically sends a change notification email when a shift's date or time is modified",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"date\") != null) or (.trigger.changed_fields | index(\"time_block\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Shift"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_shift_notification_time_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendShiftNotification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}