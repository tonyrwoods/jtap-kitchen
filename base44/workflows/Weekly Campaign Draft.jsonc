{
  "name": "Weekly Campaign Draft",
  "description": "Autonomous agent: generates a weekly newsletter draft from upcoming events and featured dishes, saved as a Draft campaign for admin review in Email Marketing.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 14 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_campaign_draft",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "draftCampaignFromActivity",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}